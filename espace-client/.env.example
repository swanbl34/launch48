# ── Supabase ────────────────────────────────────────────────────────────────
# URL du projet Supabase (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé service_role (Settings → API → service_role secret).
# SERVEUR UNIQUEMENT. Jamais préfixée NEXT_PUBLIC_, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Admin ───────────────────────────────────────────────────────────────────
# Mot de passe d'accès à /admin
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session admin (HMAC-SHA256).
# Génère-le avec :  openssl rand -hex 32
ADMIN_SESSION_SECRET=change-moi-aussi-64-caracteres-hex

# ── Démo (optionnel) ────────────────────────────────────────────────────────
# DEMO_MODE=1 sert un projet fictif sans Supabase, pour montrer l'interface
# ou faire des captures. Lecture seule. Ne jamais activer en production.
# Espace client de démo : /espace/22222222-2222-4222-8222-222222222222
# DEMO_MODE=1
